TARGET          resf2.exe
TARGETTYPE      exe

UID             0x100039CE 0xE1234567
VENDORID        0x00000000

EPOCHEAPSIZE    0x20000 0x4000000
EPOCSTACKSIZE   0x14000

CAPABILITY      ReadUserData WriteUserData UserEnvironment

SOURCEPATH      ..\src
SOURCE          main.cpp
SOURCE          engine\platform_symbian.cpp
SOURCE          engine\renderer_symbian.cpp
SOURCE          engine\input_symbian.cpp
SOURCE          clib_stubs.cpp

USERINCLUDE     ..\src
USERINCLUDE     ..\src\stl_stubs
; For WINSCW: add stl_stubs to override system headers
USERINCLUDE     ..\src\stl_stubs

SYSTEMINCLUDE   \Epoc32\include
SYSTEMINCLUDE   \Epoc32\include\stdapis
SYSTEMINCLUDE   \Epoc32\include\variant

LIBRARY         euser.lib
LIBRARY         efsrv.lib
LIBRARY         estor.lib
LIBRARY         bafl.lib
LIBRARY         cone.lib
LIBRARY         eikcore.lib
LIBRARY         avkon.lib
LIBRARY         apgrfx.lib
LIBRARY         bitgdi.lib
LIBRARY         fbscli.lib
LIBRARY         ws32.lib
LIBRARY         eikcdlg.lib
; OpenGL ES 2.0
LIBRARY         libglesv2.lib
LIBRARY         libEGL.lib
; GCCE libgcc (required for EABI helpers)
STATICLIBRARY   libgcc.lib

START RESOURCE  ..\data\resf2.rss
    TARGETPATH  \resource\apps
END

START RESOURCE  ..\data\resf2_reg.rss
    TARGETPATH  \private\10003a3f\apps
END
