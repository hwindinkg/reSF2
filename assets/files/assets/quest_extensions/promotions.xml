  <Quest Name="promo_ShopBuyReplacement">
    <Events>
      <PrePurchase />
    </Events>
    <Conditions>
      <Equal Value1="?Item(_$Purchase).SubType" Value2="Bonus" />
      <Operator Type="Or">
        <Operator Type="And">
          <Greater Value1="?Timer(Timer_FirstPayment).Value" Value2="0" />
          <Equal Value1="?Purchase(_$Purchase).Name" Value2="_promo_FirstPayment_Item" />
        </Operator>
        <Operator Type="And">
          <Greater Value1="?Timer(Timer_RepeatPayment).Value" Value2="0" />
          <Equal Value1="?Purchase(_$Purchase).Name" Value2="_LastRealPurchase" />
        </Operator>
        <Operator Type="And">
          <Greater Value1="?Timer(Timer_IncreasePayment).Value" Value2="0" />
          <Equal Value1="?Purchase(_$Purchase).Name" Value2="_promo_SalePurchase" />
        </Operator>
      </Operator>
    </Conditions>
    <Actions>
      <SetVariable Name="promo_PurchasedItemBuffer" Value="?Purchase(_$Purchase).Name" />
      <SetVariable Name="promo_PurchasedBufferItemToPurchase" Value="?Concat(?Purchase(_$Purchase).Name,_s)" />
      <Activate ActionID="promo_PurchaseBuffer" />
    </Actions>
  </Quest>
  
