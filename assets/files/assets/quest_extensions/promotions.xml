<!-- First Payment Promotion -->
  <Quest Name="promo_FirstPayment_OnFightEnter" Priority="10" Group="FightEnter" Unresumable="1">
    <Events>
      <FightEnter />
    </Events>
    <Conditions>
      <Equal Value1="?Fight(_$Fight).Battle" Value2="Survival" />
      <Equal Value1="_SurvivalsInAZoneCount" Value2="5" />
      <Operator Type="Or">
        <Equal Value1="_StarterPackOfferEnded" Value2="1" />
        <Less Value1="?Fight(ZONE_1|BOSS_LYNX|6).WinCount" Value2="1" Not="1" />
      </Operator>
      <Greater Not="1" Value1="?Timer(Timer_StarterPack).Value" Value2="0" />
      <Greater Not="1" Value1="?Timer(Timer_FirstPayment).Value" Value2="0" />
      <Greater Not="1" Value1="?Timer(Timer_RepeatPayment).Value" Value2="0" />
      <Greater Not="1" Value1="?Timer(Timer_IncreasePayment).Value" Value2="0" />
      <Greater Not="1" Value1="?Timer(sale_Timer).Value" Value2="0" />
      <Greater Not="1" Value1="_DiscipleFlag" Value2="0" />
    </Conditions>
    <Actions>
      <SetVariable Name="promo_FirstPayment_Item" Value="Pile_Gems" />
      <ClearQuestQueue Name="SurvivalPayReminder" />
      <ActivateTimer Name="Timer_FirstPayment" Value="1800" />
      <ShowMapButton Name="Button_FirstPayment" Image="?Item(_promo_FirstPayment_Item).Image" Timer="Timer_FirstPayment" />
      <Discount Item="_promo_FirstPayment_Item" NewAmount="?Multi(_promo_Multiplier,?Item(_promo_FirstPayment_Item).RecieveBonus)" Period="?Timer(Timer_FirstPayment).Value" Toggle="1" />
      <Dialog Type="Multiline" Title="dlgSpecialOfferTitle" Image="?Item(_promo_FirstPayment_Item).Image">
        <Line Text="dlgFirstPaymentOffer{?Concat(%,_promo_FirstPayment_Item}{?Multi(?Sub(_promo_Multiplier,1),100)}"/>
        <PriceLine Text="dlgProfitablePrice{textures/misc/ruby.png}{?Multi(_promo_Multiplier,?Item(_promo_FirstPayment_Item).RecieveBonus)}{?Item(_promo_FirstPayment_Item).RealPrice}" TextColor="0xfefe95" />
        <Button Type="Right" Color="Green" Text="dlgBuyButton">
          <SetVariable Name="promo_PurchasedItemBuffer" Value="_promo_FirstPayment_Item" />
          <SetVariable Name="promo_PurchasedBufferItemToPurchase" Value="?Concat(_promo_FirstPayment_Item,_s)" />
          <Activate ActionID="promo_PurchaseBuffer" />
        </Button>
        <Button Type="Left" Color="Red" Text="dlgLaterBtn" >
          <Dialog Type="Multiline" Title="dlgSpecialOfferTitle" Image="?Item(_promo_FirstPayment_Item).Image">
            <Line Text="dlgFirstPaymentRefusal">
              <Timer Name="Timer_FirstPayment" />
            </Line>
            <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk" />
          </Dialog>
          <Fight Name="_$Fight" />
        </Button>
      </Dialog>
    </Actions>
  </Quest>

