<Quests>

  <Quest Name="RaidTutorialLauncherFightEnd" Priority="-10" Unresumable="1">
    <Events>
      <FightEnd />
    </Events>
    <Conditions>
      <GreaterEqual Value1="?Fight(ZONE_1|BOSS_LYNX|5).WinCount" Value2="1" />
      <Equal Value1="?RaidInfo().TutorialStep" Value2="NotStarted"/>
    </Conditions>
    <Actions Place="Map">
      <Activate ActionID="LaunchRaidTutorial"/>
    </Actions>
  </Quest>
  
