  <Quest Name="ShowRaidButtonTutorial" Priority="-10" Unresumable="1">
    <Events>
      <Activate/>
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="LaunchRaidTutorial"/>
    </Conditions>
    <Actions>
      <ChangeScene Destination="Map" />
      <Dialog Type="Regular" Title="RAIDBOSS_FIRE" Image="boss_fire">
        <Line Text="dlgRaidIntro1" />
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnMore"/>
      </Dialog>
      <Dialog Type="Regular" Title="RAIDBOSS_FIRE" Image="boss_fire">
        <Line Text="dlgRaidIntro2" />
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk"/>
      </Dialog>
      <ShowRaidsGag Value="1"/>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidMap"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk">
          <SetRaidInfoTutorialStep Value="RaidGiveKeyTutorial"/>
          <RaidsButtonTutorial/>
        </Button>
      </Dialog>
    </Actions>
  </Quest>
  
  <Quest Name="RaidGiveKeyTutorial" Priority="-10" Unresumable="1">
    <Events>
      <RaidLogin />
    </Events>
    <Conditions>
      <Equal Value1="?RaidInfo().TutorialStep" Value2="RaidGiveKeyTutorial"/>
    </Conditions>
    <Actions Place="Map">
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidAboutKeys" />
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnMore"/>
      </Dialog>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidKey0{textures/misc/Key0.png}{?RaidInfo().RestoreCurrencyValue}"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk">
          <SetRaidInfoTutorialStep Value="FirstRaidEnterTutorial" />
        </Button>
      </Dialog>
    </Actions>
  </Quest>
  
  <Quest Name="FirstRaidEnterTutorial" Priority="-10" Unresumable="1">
    <Events>
      <RaidEnter/>
    </Events>
    <Conditions>
      <Equal Value1="?RaidInfo().TutorialStep" Value2="FirstRaidEnterTutorial"/>
    </Conditions>
    <Actions>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidShield"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk">
          <ShowRaidFightTutorial/>
          <SetRaidInfoTutorialStep Value="RaidFinalFightTutorial" />
        </Button>
      </Dialog>
    </Actions>
  </Quest>
  
  <Quest Name="RaidFinalFightTutorial" Priority="-10" Unresumable="1">
    <Events>
      <BossShieldDestroyed/>
    </Events>
    <Conditions>
      <Equal Value1="?RaidInfo().TutorialStep" Value2="RaidFinalFightTutorial"/>
    </Conditions>
    <Actions>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidShieldOff"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk">
          <SetRaidInfoTutorialStep Value="LeagueWindowTutorial" />
        </Button>
      </Dialog>
    </Actions>
  </Quest>
  
  <Quest Name="LeagueWindowTutorial" Priority="-10" Unresumable="1">
    <Events>
      <RaidEnd/>
    </Events>
    <Conditions>
      <Equal Value1="?RaidInfo().TutorialStep" Value2="LeagueWindowTutorial"/>
    </Conditions>
    <Actions>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidShowLeagues1"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnMore"/>
      </Dialog>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidShowLeagues2"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk">
          <ShowLeagueWindow />
          <SetRaidInfoTutorialStep Value="RaidShopNotification" />
        </Button>
      </Dialog>
    </Actions>
  </Quest>
  
  <Quest Name="RaidShopNotification" Priority="-10" Unresumable="1">
    <Events>
      <ChangeTab/>
    </Events>
    <Conditions>
      <Equal Value1="_$SceneTo" Value2="Shop"/>
      <Equal Value1="?RaidInfo().TutorialStep" Value2="RaidShopNotification"/>
    </Conditions>
    <Actions>
      <Dialog Type="NoAvatar" Title="dlgAlertTitle">
        <Line Text="dlgRaidShowShop"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnOk" />
      </Dialog>
      <OpenShop Tab="RaidConsumable"/>
      <SetRaidInfoTutorialStep Value="TutorialComplete" />
    </Actions>
  </Quest>
  
